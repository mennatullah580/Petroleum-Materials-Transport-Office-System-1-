@page
@model Petroleum_Materials_Transport_Office_System.Pages.Finance.ReportViewerModel
@{
    Layout = null;
    ViewData["Title"] = "نتائج التقرير";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #f4f6f9; font-family: 'Cairo', sans-serif; direction: rtl; padding: 30px; }
        .report-container { background: white; padding: 40px; border-radius: 15px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); max-width: 1200px; margin: 0 auto; }
        .header { text-align: center; margin-bottom: 40px; border-bottom: 2px solid #eee; padding-bottom: 20px; }
        .header h2 { color: #2F4156; margin: 0; font-size: 28px; }
        .header p { color: #777; margin-top: 10px; font-size: 16px; }
        .table-custom { width: 100%; border-collapse: collapse; margin-top: 20px; }
        .table-custom th { background-color: #2F4156; color: white; padding: 15px; text-align: right; }
        .table-custom td { padding: 15px; border-bottom: 1px solid #eee; color: #333; }
        .table-custom tr:hover { background-color: #f9f9f9; }
        .total-box { background-color: #e8f5e9; color: #2e7d32; padding: 20px; text-align: center; border-radius: 10px; margin-top: 30px; font-size: 20px; font-weight: bold; border: 1px solid #c8e6c9; }
        .btn-back { display: inline-block; background: #567C8D; color: white; text-decoration: none; padding: 10px 20px; border-radius: 5px; margin-bottom: 20px; font-weight: bold; }
        .btn-back:hover { background: #4a6b7c; }
    </style>
</head>
<body>

    <a href="/Finance/Reports" class="btn-back"><i class="fa-solid fa-arrow-right"></i> عودة للبحث</a>

    <div class="report-container">
        <div class="header">
            <h2><i class="fa-solid fa-file-invoice-dollar"></i> @Model.ReportTitle</h2>
            <p>من: @Model.FromDateStr | إلى: @Model.ToDateStr</p>
        </div>

        @if (Model.ReportData != null && Model.ReportData.Count > 0)
        {
            <table class="table-custom">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>التاريخ</th>
                        <th>الاسم (العميل/المورد)</th>
                        <th>البيان</th>
                        <th>القيمة</th>
                        <th>ملاحظات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.ReportData)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Date</td>
                            <td>@item.Name</td>
                            <td>@item.Type</td>
                            <td style="font-weight:bold;">@item.Amount.ToString("N2")</td>
                            <td>@item.Notes</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="total-box">
                الإجمالي في هذه الفترة: @Model.TotalAmount.ToString("N2") جنيه
            </div>
        }
        else
        {
            <div style="text-align:center; padding: 40px; color:#777;">
                <i class="fa-regular fa-folder-open" style="font-size: 50px; margin-bottom:15px; display:block;"></i>
                <h3>لا توجد بيانات متاحة لهذا التقرير في الفترة المحددة</h3>
            </div>
        }
    </div>

</body>
</html>