@page
@model Petroleum_Materials_Transport_Office_System.Pages.Master_Lists.Financial_ConfigurationModel
@{
    ViewData["Title"] = "Financial_Configuration";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>الإعدادات المالية</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --color-navy: #2F4156;
            --color-teal: #567C8D;
            --color-sky-blue: #C8D9E6;
            --color-beige: #F5EFEB;
            --color-white: #FFFFFF;
        }

        body {
            background-color: var(--color-sky-blue);
            font-family: 'Cairo', sans-serif;
            padding: 20px;
        }

        .master-card {
            background-color: var(--color-teal);
            border-radius: 15px;
            padding: 25px;
            box-shadow: 0 8px 20px rgba(0,0,0,0.1);
            min-height: 80vh;
        }

        .page-header {
            color: var(--color-white);
            margin-bottom: 25px;
            border-bottom: 2px solid rgba(255,255,255,0.2);
            padding-bottom: 15px;
        }

        .nav-pills .nav-link {
            background-color: rgba(255,255,255,0.2);
            color: var(--color-white);
            margin-left: 10px;
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.3s;
        }

            .nav-pills .nav-link.active {
                background-color: var(--color-beige);
                color: var(--color-navy);
                transform: translateY(-2px);
                box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            }

            .nav-pills .nav-link:hover:not(.active) {
                background-color: rgba(255,255,255,0.4);
            }

        .content-area {
            background-color: var(--color-beige);
            border-radius: 12px;
            padding: 25px;
            margin-top: 20px;
            border: 1px solid rgba(0,0,0,0.05);
        }

        .filter-box {
            background-color: var(--color-navy);
            color: var(--color-white);
            padding: 20px;
            border-radius: 10px;
            margin-bottom: 25px;
        }

        .form-control, .form-select {
            border: none;
            border-radius: 6px;
        }

        .custom-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
        }

            .custom-table thead {
                background-color: var(--color-navy);
                color: var(--color-white);
                white-space: nowrap;
            }

            .custom-table th, .custom-table td {
                padding: 12px 15px;
                border-bottom: 1px solid #ddd;
                text-align: center;
                vertical-align: middle;
            }

                .custom-table th:first-child {
                    border-top-right-radius: 8px;
                }

                .custom-table th:last-child {
                    border-top-left-radius: 8px;
                }

            .custom-table tbody tr:hover {
                background-color: #e9e2de;
                cursor: pointer;
            }

        .btn-action {
            background-color: var(--color-teal);
            color: white;
            border: none;
            padding: 5px 15px;
            border-radius: 5px;
            font-size: 0.9em;
            transition: background-color 0.3s;
        }

            .btn-action:hover {
                background-color: var(--color-navy);
                color: white;
            }

        /* New buttons styling to match theme but differentiate actions */
        .btn-add {
            background-color: var(--color-teal);
            color: white;
            border: 1px solid rgba(255,255,255,0.3);
        }

            .btn-add:hover {
                background-color: var(--color-sky-blue);
                color: var(--color-navy);
            }

        .btn-search {
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
        }

        @@media print {
            body {
                background-color: white;
            }

            .master-card {
                background-color: white;
                box-shadow: none;
                padding: 0;
            }

            .filter-box, .nav-pills, .no-print {
                display: none !important;
            }

            .content-area {
                border: none;
                padding: 0;
            }

            .custom-table th {
                background-color: #ddd !important;
                color: black !important;
            }
        }
    </style>
</head>
<body>

    <div class="container-fluid">
        <div class="master-card">

            <div class="d-flex justify-content-between align-items-center page-header">
                <div>
                    <h2 class="m-0"><i class="fas fa-coins ms-2"></i> الإعدادات المالية</h2>
                    <small class="text-white-50">تعريف الخزائن، البنوك، بنود المصروفات، ومراكز التكلفة</small>
                </div>
                <div>
                    <button class="btn btn-light no-print" onclick="window.print()">
                        <i class="fas fa-print ms-1"></i> طباعة القائمة
                    </button>
                </div>
            </div>

            <ul class="nav nav-pills mb-3 no-print" id="pills-tab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(Model.ActiveTab == "treasury" ? "active" : "")"
                            id="pills-treasury-tab" data-bs-toggle="pill" data-bs-target="#pills-treasury" type="button" role="tab">
                        <i class="fas fa-university ms-1"></i> الخزائن والبنوك
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(Model.ActiveTab == "expenses" ? "active" : "")"
                            id="pills-expenses-tab" data-bs-toggle="pill" data-bs-target="#pills-expenses" type="button" role="tab">
                        <i class="fas fa-list-ul ms-1"></i> بنود المصروفات
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(Model.ActiveTab == "cost-centers" ? "active" : "")"
                            id="pills-cost-centers-tab" data-bs-toggle="pill" data-bs-target="#pills-cost-centers" type="button" role="tab">
                        <i class="fas fa-sitemap ms-1"></i> مراكز التكلفة
                    </button>
                </li>
            </ul>

            <div class="content-area">
                <div class="tab-content" id="pills-tabContent">

                    <div class="tab-pane fade @(Model.ActiveTab == "treasury" ? "show active" : "")" id="pills-treasury" role="tabpanel">
                        <form method="get">
                            <div class="filter-box row g-3 no-print">
                                <div class="col-md-4">
                                    <label>بحث باسم الخزينة / البنك</label>
                                    <input type="text" name="SearchTreasury" value="@Model.SearchTreasury" class="form-control" placeholder="">
                                </div>
                                <div class="col-md-3">
                                    <label>النوع</label>
                                    <select class="form-select" name="FilterTreasuryType">
                                        <option value="">الكل</option>
                                        <option value="Safe" selected="@(Model.FilterTreasuryType == "Safe" ? "selected" : null)">خزينة نقدية</option>
                                        <option value="Bank" selected="@(Model.FilterTreasuryType == "Bank" ? "selected" : null)">حساب بنكي</option>
                                    </select>
                                </div>
                                <div class="col-md-2 align-self-end">
                                    <button type="submit" class="btn btn-action btn-search w-100">بحث</button>
                                </div>
                                <div class="col-md-3 align-self-end">
                                    <button type="button" class="btn btn-add btn-search w-100" onclick="openAddModal('treasury')">
                                        <i class="fas fa-plus ms-1"></i> إضافة خزينة/بنك
                                    </button>
                                </div>
                            </div>
                        </form>

                        <div class="table-responsive">
                            <table class="table custom-table">
                                <thead>
                                    <tr>
                                        <th>الكود</th>
                                        <th>الاسم (الخزينة/البنك)</th>
                                        <th>النوع</th>
                                        <th>رقم الحساب</th>
                                        <th>الرصيد الافتتاحي</th>
                                        <th>الرصيد الحالي</th>
                                        <th>الحالة</th>
                                        <th class="no-print">الإجراءات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Treasuries.Count > 0)
                                    {
                                        foreach (var item in Model.Treasuries)
                                        {
                                            <tr>
                                                <td>@item.ID</td>
                                                <td class="fw-bold">@item.Name</td>
                                                <td>
                                                    @if (item.Type == "Safe")
                                                    {
                                                        <span class="badge bg-success">خزينة</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-primary">بنك</span>
                                                    }
                                                </td>
                                                <td>@item.AccountNumber</td>
                                                <td>@item.InitialBalance.ToString("N2")</td>
                                                <td class="text-success fw-bold">@item.CurrentBalance.ToString("N2")</td>
                                                <td>
                                                    @if (item.Status == "Active")
                                                    {
                                                        <span class="badge bg-success">نشط</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger">موقوف</span>
                                                    }
                                                </td>
                                                <td class="no-print">
                                                    <div class="d-flex gap-2 justify-content-center">
                                                        <button class="btn btn-action btn-sm" onclick="openDetailsModal(@item.ID, 'treasury')" title="تفاصيل">
                                                            <i class="fas fa-eye"></i>
                                                        </button>
                                                        <button class="btn btn-warning btn-sm text-white" onclick="openEditModal(@item.ID, 'treasury')" title="تعديل">
                                                            <i class="fas fa-pen"></i>
                                                        </button>
                                                        <button class="btn btn-danger btn-sm" onclick="deleteItem(@item.ID, 'treasury')" title="حذف">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="8" class="text-muted">لا توجد بيانات متاحة</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="tab-pane fade @(Model.ActiveTab == "expenses" ? "show active" : "")" id="pills-expenses" role="tabpanel">
                        <form method="get">
                            <div class="filter-box row g-3 no-print">
                                <div class="col-md-4">
                                    <label>بحث عن بند مصروف</label>
                                    <input type="text" name="SearchExpense" value="@Model.SearchExpense" class="form-control" placeholder="">
                                </div>
                                <div class="col-md-3">
                                    <label>تصنيف المصروف</label>
                                    <select class="form-select" name="FilterExpenseCategory">
                                        <option value="">الكل</option>
                                        <option value="مصروفات تشغيل" selected="@(Model.FilterExpenseCategory == "مصروفات تشغيل" ? "selected" : null)">مصروفات تشغيل</option>
                                        <option value="مصروفات إدارية" selected="@(Model.FilterExpenseCategory == "مصروفات إدارية" ? "selected" : null)">مصروفات إدارية</option>
                                        <option value="صيانة" selected="@(Model.FilterExpenseCategory == "صيانة" ? "selected" : null)">صيانة</option>
                                    </select>
                                </div>
                                <div class="col-md-2 align-self-end">
                                    <button type="submit" class="btn btn-action btn-search w-100">بحث</button>
                                </div>
                                <div class="col-md-3 align-self-end">
                                    <button type="button" class="btn btn-add btn-search w-100" onclick="openAddModal('expense')">
                                        <i class="fas fa-plus ms-1"></i> إضافة بند مصروف
                                    </button>
                                </div>
                            </div>
                        </form>

                        <div class="table-responsive">
                            <table class="table custom-table">
                                <thead>
                                    <tr>
                                        <th>كود البند</th>
                                        <th>اسم المصروف</th>
                                        <th>التصنيف الرئيسي</th>
                                        <th>نوع القيمة (ثابتة/متغيرة)</th>
                                        <th>يظهر في التقارير؟</th>
                                        <th class="no-print">الإجراءات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Expenses.Count > 0)
                                    {
                                        foreach (var item in Model.Expenses)
                                        {
                                            <tr>
                                                <td>@item.ID</td>
                                                <td class="fw-bold">@item.Name</td>
                                                <td>@item.Category</td>
                                                <td>@item.ValueType</td>
                                                <td>
                                                    @if (item.IsReportable)
                                                    {
                                                        <i class="fas fa-check-circle text-success"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="fas fa-times-circle text-danger"></i>
                                                    }
                                                </td>
                                                <td class="no-print">
                                                    <div class="d-flex gap-2 justify-content-center">
                                                        <button class="btn btn-action btn-sm" onclick="openDetailsModal(@item.ID, 'expense')" title="تفاصيل">
                                                            <i class="fas fa-eye"></i>
                                                        </button>
                                                        <button class="btn btn-warning btn-sm text-white" onclick="openEditModal(@item.ID, 'expense')" title="تعديل">
                                                            <i class="fas fa-pen"></i>
                                                        </button>
                                                        <button class="btn btn-danger btn-sm" onclick="deleteItem(@item.ID, 'expense')" title="حذف">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="6" class="text-muted">لا توجد بيانات متاحة</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="tab-pane fade @(Model.ActiveTab == "cost-centers" ? "show active" : "")" id="pills-cost-centers" role="tabpanel">
                        <form method="get">
                            <div class="filter-box row g-3 no-print">
                                <div class="col-md-4">
                                    <label>اسم مركز التكلفة</label>
                                    <input type="text" name="SearchCostCenter" value="@Model.SearchCostCenter" class="form-control" placeholder="">
                                </div>
                                <div class="col-md-3">
                                    <label>الحالة</label>
                                    <select class="form-select" name="FilterCostCenterStatus">
                                        <option value="">الكل</option>
                                        <option value="Active" selected="@(Model.FilterCostCenterStatus == "Active" ? "selected" : null)">نشط</option>
                                        <option value="Inactive" selected="@(Model.FilterCostCenterStatus == "Inactive" ? "selected" : null)">موقوف</option>
                                    </select>
                                </div>
                                <div class="col-md-2 align-self-end">
                                    <button type="submit" class="btn btn-action btn-search w-100">بحث</button>
                                </div>
                                <div class="col-md-3 align-self-end">
                                    <button type="button" class="btn btn-add btn-search w-100" onclick="openAddModal('costCenter')">
                                        <i class="fas fa-plus ms-1"></i> إضافة مركز تكلفة
                                    </button>
                                </div>
                            </div>
                        </form>

                        <div class="table-responsive">
                            <table class="table custom-table">
                                <thead>
                                    <tr>
                                        <th>كود المركز</th>
                                        <th>اسم مركز التكلفة</th>
                                        <th>المشرف المسؤول</th>
                                        <th>تاريخ الإنشاء</th>
                                        <th>الحالة</th>
                                        <th class="no-print">الإجراءات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.CostCenters.Count > 0)
                                    {
                                        foreach (var item in Model.CostCenters)
                                        {
                                            <tr>
                                                <td>@item.ID</td>
                                                <td class="fw-bold">@item.Name</td>
                                                <td>@item.Supervisor</td>
                                                <td>@item.CreatedAt.ToString("yyyy-MM-dd")</td>
                                                <td>
                                                    @if (item.Status == "Active")
                                                    {
                                                        <span class="badge bg-success">نشط</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger">موقوف</span>
                                                    }
                                                </td>
                                                <td class="no-print">
                                                    <div class="d-flex gap-2 justify-content-center">
                                                        <button class="btn btn-action btn-sm" onclick="openDetailsModal(@item.ID, 'costCenter')" title="تفاصيل">
                                                            <i class="fas fa-eye"></i>
                                                        </button>
                                                        <button class="btn btn-warning btn-sm text-white" onclick="openEditModal(@item.ID, 'costCenter')" title="تعديل">
                                                            <i class="fas fa-pen"></i>
                                                        </button>
                                                        <button class="btn btn-danger btn-sm" onclick="deleteItem(@item.ID, 'costCenter')" title="حذف">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="6" class="text-muted">لا توجد بيانات متاحة</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="detailsModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header" style="background-color: var(--color-navy); color: white;">
                    <h5 class="modal-title" id="modalTitle">تفاصيل</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="modalLoader" class="text-center py-3">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">جاري التحميل...</span>
                        </div>
                    </div>
                    <div id="modalContent" style="display:none;">
                        <table class="table table-bordered">
                            <tbody id="modalTableBody"></tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إغلاق</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Add/Edit Treasury Modal -->
    <div class="modal fade" id="treasuryModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header" style="background-color: var(--color-navy); color: white;">
                    <h5 class="modal-title" id="treasuryModalTitle">إضافة خزينة/بنك</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" asp-page-handler="SaveTreasury">
                    <div class="modal-body">
                        <input type="hidden" asp-for="TreasuryInput.ID" id="treasuryId" />
                        <div class="mb-3">
                            <label class="form-label">اسم الخزينة/البنك</label>
                            <input type="text" class="form-control" asp-for="TreasuryInput.Name" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">النوع</label>
                            <select class="form-select" asp-for="TreasuryInput.Type" required>
                                <option value="">اختر النوع</option>
                                <option value="Safe">خزينة نقدية</option>
                                <option value="Bank">حساب بنكي</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">رقم الحساب (اختياري)</label>
                            <input type="text" class="form-control" asp-for="TreasuryInput.AccountNumber">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">الرصيد الافتتاحي</label>
                            <input type="number" step="0.01" class="form-control" asp-for="TreasuryInput.InitialBalance" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">الحالة</label>
                            <select class="form-select" asp-for="TreasuryInput.Status" required>
                                <option value="Active">نشط</option>
                                <option value="Inactive">موقوف</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                        <button type="submit" class="btn btn-primary">حفظ</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Add/Edit Expense Modal -->
    <div class="modal fade" id="expenseModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header" style="background-color: var(--color-navy); color: white;">
                    <h5 class="modal-title" id="expenseModalTitle">إضافة بند مصروف</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" asp-page-handler="SaveExpense">
                    <div class="modal-body">
                        <input type="hidden" asp-for="ExpenseInput.ID" id="expenseId" />
                        <div class="mb-3">
                            <label class="form-label">اسم المصروف</label>
                            <input type="text" class="form-control" asp-for="ExpenseInput.Name" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">التصنيف</label>
                            <select class="form-select" asp-for="ExpenseInput.Category" required>
                                <option value="">اختر التصنيف</option>
                                <option value="مصروفات تشغيل">مصروفات تشغيل</option>
                                <option value="مصروفات إدارية">مصروفات إدارية</option>
                                <option value="صيانة">صيانة</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">نوع القيمة</label>
                            <select class="form-select" asp-for="ExpenseInput.ValueType" required>
                                <option value="">اختر نوع القيمة</option>
                                <option value="ثابتة">ثابتة</option>
                                <option value="متغيرة">متغيرة</option>
                            </select>
                        </div>
                        <div class="mb-3 form-check">
                            <input type="checkbox" class="form-check-input" asp-for="ExpenseInput.IsReportable">
                            <label class="form-check-label">يظهر في التقارير</label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                        <button type="submit" class="btn btn-primary">حفظ</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Add/Edit Cost Center Modal -->
    <div class="modal fade" id="costCenterModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header" style="background-color: var(--color-navy); color: white;">
                    <h5 class="modal-title" id="costCenterModalTitle">إضافة مركز تكلفة</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" asp-page-handler="SaveCostCenter">
                    <div class="modal-body">
                        <input type="hidden" asp-for="CostCenterInput.ID" id="costCenterId" />
                        <div class="mb-3">
                            <label class="form-label">اسم مركز التكلفة</label>
                            <input type="text" class="form-control" asp-for="CostCenterInput.Name" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">المشرف المسؤول (اختياري)</label>
                            <input type="text" class="form-control" asp-for="CostCenterInput.Supervisor">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">الحالة</label>
                            <select class="form-select" asp-for="CostCenterInput.Status" required>
                                <option value="Active">نشط</option>
                                <option value="Inactive">موقوف</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                        <button type="submit" class="btn btn-primary">حفظ</button>
                    </div>
                </form>
            </div>
        </div>
    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Function to handle opening the modal
        function openDetailsModal(id, type) {
            const modalElement = document.getElementById('detailsModal');
            const modal = new bootstrap.Modal(modalElement);
            const modalTitle = document.getElementById('modalTitle');
            const modalTableBody = document.getElementById('modalTableBody');
            const modalLoader = document.getElementById('modalLoader');
            const modalContent = document.getElementById('modalContent');

            // Show Modal and Loader
            modal.show();
            modalLoader.style.display = 'block';
            modalContent.style.display = 'none';
            modalTableBody.innerHTML = '';

            let handlerUrl = '';

            // Determine URL based on type
            if (type === 'treasury') {
                modalTitle.innerText = "تفاصيل الخزينة / البنك";
                handlerUrl = `?handler=TreasuryDetails&id=${id}`;
            } else if (type === 'expense') {
                modalTitle.innerText = "تفاصيل بند المصروف";
                handlerUrl = `?handler=ExpenseDetails&id=${id}`;
            } else if (type === 'costCenter') {
                modalTitle.innerText = "تفاصيل مركز التكلفة";
                handlerUrl = `?handler=CostCenterDetails&id=${id}`;
            }

            // Fetch Data
            fetch(handlerUrl)
                .then(response => {
                    if (!response.ok) throw new Error("Network response was not ok");
                    return response.json();
                })
                .then(data => {
                    let html = '';

                    if (type === 'treasury') {
                        html += `<tr><th>الكود</th><td>${data.id}</td></tr>`;
                        html += `<tr><th>الاسم</th><td>${data.name}</td></tr>`;
                        html += `<tr><th>النوع</th><td>${data.type === 'Safe' ? 'خزينة' : 'بنك'}</td></tr>`;
                        html += `<tr><th>رقم الحساب</th><td>${data.accountNumber}</td></tr>`;
                        html += `<tr><th>الرصيد الافتتاحي</th><td>${data.initialBalance.toFixed(2)}</td></tr>`;
                        html += `<tr><th>الرصيد الحالي</th><td class="text-success fw-bold">${data.currentBalance.toFixed(2)}</td></tr>`;
                        html += `<tr><th>الحالة</th><td>${data.status}</td></tr>`;
                    }
                    else if (type === 'expense') {
                        html += `<tr><th>الكود</th><td>${data.id}</td></tr>`;
                        html += `<tr><th>الاسم</th><td>${data.name}</td></tr>`;
                        html += `<tr><th>التصنيف</th><td>${data.category}</td></tr>`;
                        html += `<tr><th>نوع القيمة</th><td>${data.valueType}</td></tr>`;
                        html += `<tr><th>تقارير</th><td>${data.isReportable ? 'نعم' : 'لا'}</td></tr>`;
                    }
                    else if (type === 'costCenter') {
                        html += `<tr><th>الكود</th><td>${data.id}</td></tr>`;
                        html += `<tr><th>الاسم</th><td>${data.name}</td></tr>`;
                        html += `<tr><th>المشرف</th><td>${data.supervisor}</td></tr>`;
                        html += `<tr><th>الحالة</th><td>${data.status}</td></tr>`;
                        html += `<tr><th>تاريخ الإنشاء</th><td>${new Date(data.createdAt).toLocaleDateString('en-GB')}</td></tr>`;
                    }

                    modalTableBody.innerHTML = html;
                    modalLoader.style.display = 'none';
                    modalContent.style.display = 'block';
                })
                .catch(error => {
                    console.error('Error:', error);
                    modalTableBody.innerHTML = '<tr><td colspan="2" class="text-danger">حدث خطأ أثناء جلب البيانات</td></tr>';
                    modalLoader.style.display = 'none';
                    modalContent.style.display = 'block';
                });
        }

        // Function to open Add/Edit modal for Treasury
        function openTreasuryModal(id = 0) {
            const modal = new bootstrap.Modal(document.getElementById('treasuryModal'));
            const title = document.getElementById('treasuryModalTitle');
            const idInput = document.getElementById('treasuryId');

            if (id > 0) {
                // Edit mode
                title.innerText = "تعديل خزينة/بنك";
                idInput.value = id;

                // Fetch existing data
                fetch(`?handler=TreasuryDetails&id=${id}`)
                    .then(response => response.json())
                    .then(data => {
                        document.querySelector('input[name="TreasuryInput.Name"]').value = data.name || '';
                        document.querySelector('select[name="TreasuryInput.Type"]').value = data.type || '';
                        document.querySelector('input[name="TreasuryInput.AccountNumber"]').value = data.accountNumber || '';
                        document.querySelector('input[name="TreasuryInput.InitialBalance"]').value = data.initialBalance || 0;
                        document.querySelector('select[name="TreasuryInput.Status"]').value = data.status || 'Active';
                        modal.show();
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        alert('حدث خطأ أثناء تحميل البيانات');
                    });
            } else {
                // Add mode
                title.innerText = "إضافة خزينة/بنك";
                idInput.value = 0;

                // Clear form
                document.querySelector('input[name="TreasuryInput.Name"]').value = '';
                document.querySelector('select[name="TreasuryInput.Type"]').value = '';
                document.querySelector('input[name="TreasuryInput.AccountNumber"]').value = '';
                document.querySelector('input[name="TreasuryInput.InitialBalance"]').value = 0;
                document.querySelector('select[name="TreasuryInput.Status"]').value = 'Active';

                modal.show();
            }
        }

        // Function to open Add/Edit modal for Expense
        function openExpenseModal(id = 0) {
            const modal = new bootstrap.Modal(document.getElementById('expenseModal'));
            const title = document.getElementById('expenseModalTitle');
            const idInput = document.getElementById('expenseId');

            if (id > 0) {
                // Edit mode
                title.innerText = "تعديل بند مصروف";
                idInput.value = id;

                // Fetch existing data
                fetch(`?handler=ExpenseDetails&id=${id}`)
                    .then(response => response.json())
                    .then(data => {
                        document.querySelector('input[name="ExpenseInput.Name"]').value = data.name || '';
                        document.querySelector('select[name="ExpenseInput.Category"]').value = data.category || '';
                        document.querySelector('select[name="ExpenseInput.ValueType"]').value = data.valueType || '';
                        document.querySelector('input[name="ExpenseInput.IsReportable"]').checked = data.isReportable || false;
                        modal.show();
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        alert('حدث خطأ أثناء تحميل البيانات');
                    });
            } else {
                // Add mode
                title.innerText = "إضافة بند مصروف";
                idInput.value = 0;

                // Clear form
                document.querySelector('input[name="ExpenseInput.Name"]').value = '';
                document.querySelector('select[name="ExpenseInput.Category"]').value = '';
                document.querySelector('select[name="ExpenseInput.ValueType"]').value = '';
                document.querySelector('input[name="ExpenseInput.IsReportable"]').checked = false;

                modal.show();
            }
        }

        // Function to open Add/Edit modal for Cost Center
        function openCostCenterModal(id = 0) {
            const modal = new bootstrap.Modal(document.getElementById('costCenterModal'));
            const title = document.getElementById('costCenterModalTitle');
            const idInput = document.getElementById('costCenterId');

            if (id > 0) {
                // Edit mode
                title.innerText = "تعديل مركز تكلفة";
                idInput.value = id;

                // Fetch existing data
                fetch(`?handler=CostCenterDetails&id=${id}`)
                    .then(response => response.json())
                    .then(data => {
                        document.querySelector('input[name="CostCenterInput.Name"]').value = data.name || '';
                        document.querySelector('input[name="CostCenterInput.Supervisor"]').value = data.supervisor || '';
                        document.querySelector('select[name="CostCenterInput.Status"]').value = data.status || 'Active';
                        modal.show();
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        alert('حدث خطأ أثناء تحميل البيانات');
                    });
            } else {
                // Add mode
                title.innerText = "إضافة مركز تكلفة";
                idInput.value = 0;

                // Clear form
                document.querySelector('input[name="CostCenterInput.Name"]').value = '';
                document.querySelector('input[name="CostCenterInput.Supervisor"]').value = '';
                document.querySelector('select[name="CostCenterInput.Status"]').value = 'Active';

                modal.show();
            }
        }

        // Unified function to open modals based on type
        function openAddModal(type) {
            switch(type) {
                case 'treasury':
                    openTreasuryModal(0);
                    break;
                case 'expense':
                    openExpenseModal(0);
                    break;
                case 'costCenter':
                    openCostCenterModal(0);
                    break;
            }
        }

        // Unified function to open edit modals based on type
        function openEditModal(id, type) {
            switch(type) {
                case 'treasury':
                    openTreasuryModal(id);
                    break;
                case 'expense':
                    openExpenseModal(id);
                    break;
                case 'costCenter':
                    openCostCenterModal(id);
                    break;
            }
        }

        // Function to delete items
        function deleteItem(id, type) {
            if(confirm("هل أنت متأكد من حذف هذا العنصر؟")) {
                let form = document.createElement('form');
                form.method = 'post';
                form.style.display = 'none';

                let input = document.createElement('input');
                input.type = 'hidden';
                input.name = '__RequestVerificationToken';
                input.value = document.querySelector('input[name="__RequestVerificationToken"]').value;
                form.appendChild(input);

                // Set the appropriate handler based on type
                switch(type) {
                    case 'treasury':
                        form.action = `?handler=DeleteTreasury&id=${id}`;
                        break;
                    case 'expense':
                        form.action = `?handler=DeleteExpense&id=${id}`;
                        break;
                    case 'costCenter':
                        form.action = `?handler=DeleteCostCenter&id=${id}`;
                        break;
                }

                document.body.appendChild(form);
                form.submit();
            }
        }

        // Make functions globally available
        window.openAddModal = openAddModal;
        window.openEditModal = openEditModal;
        window.deleteItem = deleteItem;
        window.openDetailsModal = openDetailsModal;
    </script>

</body>
</html>